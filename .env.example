ANTHROPIC_API_KEY=sk-ant-api03-...
PORT=3000

# Modelo de Claude a usar para generar dashboards.
# Por defecto: claude-sonnet-4-6 (balance costo/calidad)
# Opciones disponibles:
#   claude-sonnet-4-6   → recomendado, más económico
#   claude-opus-4-6     → máxima calidad, mayor costo
#   claude-haiku-4-5    → más rápido y barato, menor profundidad
ANTHROPIC_MODEL=claude-sonnet-4-6
